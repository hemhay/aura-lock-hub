<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aura Lock Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #07090f;
            --surface: rgba(255, 255, 255, 0.04);
            --surface-hover: rgba(255, 255, 255, 0.07);
            --border: rgba(255, 255, 255, 0.08);
            --text: #f0f2f8;
            --muted: #8b93a8;
            --accent: #00e5c7;
            --accent-dim: rgba(0, 229, 199, 0.15);
            --accent-glow: rgba(0, 229, 199, 0.35);
            --purple: #7c5cff;
            --granted: #34d399;
            --denied: #f87171;
            --radius: 16px;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'DM Sans', system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            line-height: 1.5;
            overflow-x: hidden;
        }

        .bg-mesh {
            position: fixed;
            inset: 0;
            z-index: 0;
            background:
                radial-gradient(ellipse 80% 60% at 10% 20%, rgba(124, 92, 255, 0.18), transparent),
                radial-gradient(ellipse 60% 50% at 90% 80%, rgba(0, 229, 199, 0.12), transparent),
                radial-gradient(ellipse 50% 40% at 50% 50%, rgba(0, 100, 200, 0.06), transparent);
            pointer-events: none;
        }

        .grid-overlay {
            position: fixed;
            inset: 0;
            z-index: 0;
            background-image:
                linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
            background-size: 48px 48px;
            mask-image: radial-gradient(ellipse 70% 70% at 50% 40%, black, transparent);
            pointer-events: none;
        }

        .app {
            position: relative;
            z-index: 1;
            max-width: 1100px;
            margin: 0 auto;
            padding: 2rem 1.5rem 4rem;
        }

        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .brand-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--purple), var(--accent));
            display: grid;
            place-items: center;
            box-shadow: 0 0 24px var(--accent-glow);
        }

        .brand-icon svg { width: 22px; height: 22px; color: var(--bg); }

        .brand h1 {
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .brand span {
            display: block;
            font-size: 0.75rem;
            color: var(--muted);
            font-weight: 400;
        }

        .live-pill {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.4rem 0.9rem;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 999px;
            font-size: 0.8rem;
            color: var(--muted);
        }

        .live-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--granted);
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5); }
            50% { opacity: 0.7; box-shadow: 0 0 0 6px rgba(52, 211, 153, 0); }
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 1.5rem;
            align-items: start;
        }

        @media (max-width: 768px) {
            .dashboard-grid { grid-template-columns: 1fr; }
        }

        .panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            backdrop-filter: blur(12px);
            overflow: hidden;
        }

        .control-panel {
            padding: 2rem;
            text-align: center;
        }

        .door-ring {
            position: relative;
            width: 180px;
            height: 180px;
            margin: 0 auto 1.75rem;
        }

        .door-ring::before {
            content: '';
            position: absolute;
            inset: -8px;
            border-radius: 50%;
            border: 2px solid transparent;
            background: linear-gradient(var(--bg), var(--bg)) padding-box,
                        linear-gradient(135deg, var(--purple), var(--accent)) border-box;
            opacity: 0.6;
            animation: spin 12s linear infinite;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        .door-core {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: linear-gradient(160deg, rgba(124, 92, 255, 0.2), rgba(0, 229, 199, 0.1));
            border: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.25rem;
        }

        .door-core svg { width: 48px; height: 48px; color: var(--accent); opacity: 0.9; }

        .door-status {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--muted);
            font-weight: 600;
        }

        .door-status.locked { color: var(--accent); }
        .door-status.unlocking { color: var(--purple); animation: blink 0.6s ease infinite; }
        .door-status.unlocked { color: var(--granted); }

        @keyframes blink { 50% { opacity: 0.4; } }

        .control-panel h2 {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 0.35rem;
        }

        .control-panel p {
            font-size: 0.875rem;
            color: var(--muted);
            margin-bottom: 1.5rem;
        }

        .unlock-btn {
            position: relative;
            width: 100%;
            max-width: 280px;
            padding: 1rem 1.5rem;
            font-family: inherit;
            font-size: 1rem;
            font-weight: 600;
            color: var(--bg);
            background: linear-gradient(135deg, var(--accent), #00c4aa);
            border: none;
            border-radius: 12px;
            cursor: pointer;
            overflow: hidden;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 4px 24px var(--accent-glow);
        }

        .unlock-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 32px var(--accent-glow);
        }

        .unlock-btn:active:not(:disabled) { transform: translateY(0); }

        .unlock-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .unlock-btn .shimmer {
            position: absolute;
            inset: 0;
            background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.25) 50%, transparent 60%);
            transform: translateX(-100%);
            animation: shimmer 3s ease-in-out infinite;
        }

        @keyframes shimmer {
            0% { transform: translateX(-100%); }
            60%, 100% { transform: translateX(100%); }
        }

        .logs-panel { display: flex; flex-direction: column; }

        .logs-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid var(--border);
        }

        .logs-header h2 {
            font-size: 1rem;
            font-weight: 600;
        }

        .log-count {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            color: var(--muted);
            background: var(--surface-hover);
            padding: 0.25rem 0.6rem;
            border-radius: 6px;
        }

        .log-list {
            list-style: none;
            max-height: 420px;
            overflow-y: auto;
        }

        .log-list::-webkit-scrollbar { width: 6px; }
        .log-list::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 3px;
        }

        .log-item {
            display: grid;
            grid-template-columns: auto 1fr auto;
            gap: 1rem;
            align-items: center;
            padding: 1rem 1.5rem;
            border-bottom: 1px solid var(--border);
            transition: background 0.15s;
        }

        .log-item:hover { background: var(--surface-hover); }
        .log-item:last-child { border-bottom: none; }

        .log-time {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            color: var(--muted);
            white-space: nowrap;
        }

        .log-method {
            font-size: 0.9rem;
            font-weight: 500;
        }

        .log-method::before {
            content: '';
            display: inline-block;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--purple);
            margin-right: 0.5rem;
            vertical-align: middle;
        }

        .badge {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 0.3rem 0.65rem;
            border-radius: 6px;
        }

        .badge.granted {
            background: rgba(52, 211, 153, 0.15);
            color: var(--granted);
        }

        .badge.denied {
            background: rgba(248, 113, 113, 0.15);
            color: var(--denied);
        }

        .badge.other {
            background: rgba(139, 147, 168, 0.15);
            color: var(--muted);
        }

        .empty-logs {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem 1.5rem;
            text-align: center;
            color: var(--muted);
            font-size: 0.9rem;
            border-bottom: none;
        }

        .empty-logs svg {
            width: 40px;
            height: 40px;
            margin-bottom: 0.75rem;
            opacity: 0.4;
        }

        .toast {
            position: fixed;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%) translateY(120%);
            padding: 0.85rem 1.25rem;
            background: var(--text);
            color: var(--bg);
            border-radius: 10px;
            font-size: 0.875rem;
            font-weight: 500;
            box-shadow: 0 12px 40px rgba(0,0,0,0.4);
            z-index: 100;
            transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .toast.show { transform: translateX(-50%) translateY(0); }
        .toast.error { background: var(--denied); color: white; }
    </style>
</head>
<body>
    <div class="bg-mesh" aria-hidden="true"></div>
    <div class="grid-overlay" aria-hidden="true"></div>

    <div class="app">
        <header>
            <div class="brand">
                <div class="brand-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                </div>
                <div>
                    <h1>Aura Lock Hub</h1>
                    <span>Door Control Dashboard</span>
                </div>
            </div>
            <div class="live-pill">
                <span class="live-dot"></span>
                System online
            </div>
        </header>

        <main class="dashboard-grid">
            <section class="panel control-panel">
                <div class="door-ring" id="doorRing">
                    <div class="door-core">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M12 3v18M8 7h8M8 11h8M8 15h5"/>
                        </svg>
                        <span class="door-status locked" id="doorStatus">Secured</span>
                    </div>
                </div>
                <h2>Remote Access</h2>
                <p>Send an instant unlock command to the connected entry point.</p>
                <button class="unlock-btn" id="unlockBtn" onclick="unlockDoor()">
                    <span class="shimmer"></span>
                    <span id="btnLabel">Unlock Door</span>
                </button>
            </section>

            <section class="panel logs-panel">
                <div class="logs-header">
                    <h2>Recent Access Logs</h2>
                    <span class="log-count">{{#if logs}}{{logs.length}}{{else}}0{{/if}} entries</span>
                </div>
                <ul class="log-list">
                    {{#each logs}}
                    <li class="log-item">
                        <span class="log-time" data-raw="{{this.created_at}}">{{this.created_at}}</span>
                        <span class="log-method">{{this.auth_method}}</span>
                        <span class="badge">{{this.status}}</span>
                    </li>
                    {{else}}
                    <li class="empty-logs">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/>
                            <rect x="9" y="3" width="6" height="4" rx="1"/>
                        </svg>
                        <p>No access events yet.<br>Unlock activity will appear here.</p>
                    </li>
                    {{/each}}
                </ul>
            </section>
        </main>
    </div>

    <div class="toast" id="toast" role="status"></div>

    <script>
        function formatTimes() {
            document.querySelectorAll('.log-time').forEach(el => {
                const raw = el.dataset.raw;
                if (!raw) return;
                const d = new Date(raw);
                if (isNaN(d)) return;
                el.textContent = d.toLocaleString(undefined, {
                    month: 'short', day: 'numeric',
                    hour: '2-digit', minute: '2-digit', second: '2-digit'
                });
            });
        }

        function badgeClass(status) {
            const s = (status || '').toLowerCase();
            if (s === 'granted') return 'granted';
            if (s === 'denied') return 'denied';
            return 'other';
        }

        document.querySelectorAll('.badge').forEach(b => {
            const text = b.textContent.trim();
            b.className = 'badge ' + badgeClass(text);
        });

        function showToast(msg, isError) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.classList.toggle('error', !!isError);
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 3200);
        }

        function setDoorState(state) {
            const status = document.getElementById('doorStatus');
            const ring = document.getElementById('doorRing');
            status.className = 'door-status ' + state;
            if (state === 'unlocking') {
                status.textContent = 'Unlocking…';
                ring.style.animation = 'none';
            } else if (state === 'unlocked') {
                status.textContent = 'Unlocked';
            } else {
                status.textContent = 'Secured';
            }
        }

        async function unlockDoor() {
            const btn = document.getElementById('unlockBtn');
            const label = document.getElementById('btnLabel');
            btn.disabled = true;
            label.textContent = 'Sending…';
            setDoorState('unlocking');

            try {
                const res = await fetch('/unlock', { method: 'POST' });
                if (res.ok) {
                    setDoorState('unlocked');
                    showToast('Unlock command sent successfully');
                    setTimeout(() => location.reload(), 1400);
                } else {
                    throw new Error('Server error');
                }
            } catch {
                setDoorState('locked');
                showToast('Failed to send unlock command', true);
                btn.disabled = false;
                label.textContent = 'Unlock Door';
            }
        }

        formatTimes();
    </script>
</body>
</html>
